[Unit]
Description=Stockhunt paper desk API (board + manager desk, behind the login)
Documentation=https://github.com/TruongTrReal/stockhunt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stockhunt
Group=stockhunt
# The repo's "folder names contain spaces" rule reaches into the unit file. systemd 249
# splits WorkingDirectory= on whitespace and takes quotes literally, so there is no way to
# spell "paper api" in it -- the cd happens in the shell instead. ReadWritePaths= IS a
# list type and does honour quotes, which is why those stay inline.
ExecStart=/bin/sh -c 'cd "/opt/stockhunt/paper api" && exec /opt/stockhunt/.venv/bin/python -u run_api.py --host 127.0.0.1 --port 8080'
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# A BACKSTOP, not the fix. The descriptor leak that made this necessary is fixed in
# `authdb._reap`; this is here so that the next leak of the same shape degrades slowly
# enough to be noticed instead of taking the board down in an afternoon.
#
# systemd's default is 1024, which this process reached in about seven hours of ordinary
# traffic on 2026-08-18 -- one visitor, a tab polling `index.html` once a minute. At the
# limit every request that has to open a file fails with `OSError: [Errno 24]`, including
# serving the board's own index.html, while the unit still reports active and nginx
# returns 500. The symptom names the victim, never the cause.
LimitNOFILE=65536

# This process owns no trading and writes only its own state. Keep it that way.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The last path is the research store, and the API writes exactly one kind of row in
# it: a scoring JOB from `/v1/research/trials`. It ranks out of the same file and
# scores nothing itself -- `research_worker.py` drains the queue, on the same seam
# `deskdb` draws between this process and the desk. Without write access the board
# still renders and every submission answers 500.
ReadWritePaths="/opt/stockhunt/paper api/state" "/opt/stockhunt/paper api/logs" "/opt/stockhunt/paper trading engine/state" "/opt/stockhunt/walk-forward optimization/results"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

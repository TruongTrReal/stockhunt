[Unit]
Description=Monthly ETF rotation: decide the pick and queue orders on the desk ledger
After=network-online.target stockhunt-desk.service
Wants=network-online.target

[Service]
Type=oneshot
User=stockhunt
Group=stockhunt
WorkingDirectory=/opt/stockhunt/paper trading engine
# It writes to `state/desk.db` -- the same ledger the API writes to and `desk_control`
# drains. No API key and no HTTP: the public API is the door for managers who are not on
# this box, and this one is. It still imports no Nautilus and holds no position, so a
# failure here can delay a rebalance and can never corrupt the desk's record.
ExecStart=/opt/stockhunt/.venv/bin/python -u rotation_manager.py
# The manager decides for itself whether it is inside the decision window and exits 0 when
# it is not, so the vast majority of firings are a no-op that prints one line. Do not put
# the schedule logic in the timer: a timer that fires only at month end has to know which
# day that is, and that is exactly the calculation whose failure mode the source of this
# strategy shipped (it skipped 30% of months).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The ledger, and nothing else. `logs/` is here because the vendor client writes there.
ReadWritePaths="/opt/stockhunt/paper trading engine/state" "/opt/stockhunt/paper trading engine/logs"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
